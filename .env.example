# On Vercel, the Upstash integration sets KV_REST_API_URL and KV_REST_API_TOKEN.
# A hand-made Upstash database uses UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
# Either pair is enough. Local play without them keeps the game in this process only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Sign-in for the camera check. Games still run without these.
# DATABASE_URL is a Neon Postgres connection string.
# BETTER_AUTH_URL is the production origin only. Leave it unset on preview.
# AUTH_FROM is the Resend from-address. PASSKEY_RP_ID is the site hostname.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
RESEND_API_KEY=
AUTH_FROM=
PASSKEY_RP_ID=
TYPESAFE_API_KEY=
